<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="BankPro Suite">

    <!-- ✅ UI Tests - must run first to store accountId -->
    <test name="UI Tests">
        <classes>
            <class name="tests.LoginTest" />
            <class name="tests.OpenNewAccountTest" /> <!-- This creates and stores accountId -->
            <class name="tests.AccountOverviewTest" />
            <class name="tests.TransferFundsTest" />
            <class name="tests.LogoutTest" />
        </classes>
    </test>

    <!-- ✅ API Tests - reads accountId from shared store -->
    <test name="API Tests">
        <classes>
            <class name="api.AccountAPITest" />
        </classes>
    </test>

</suite>
